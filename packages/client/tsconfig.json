{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "es2022",
            "DOM"
        ],
        "experimentalDecorators": true,
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "exclude": [
        "dist",
        "src/index.ts"
    ],
    "paths": {
        "@labirthermal/core": [ "../core/src" ],
    }
}